# Public URL of the deployed site (used for OG image, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.jh-projectcontrols.com

# AWS SES credentials for the contact form. Sandbox mode is fine for this
# use case since every message goes to the same verified inbox.
#
# Setup:
#   1. AWS Console > SES > Verified identities > add JKH.Build@gmail.com
#      (or a domain you own), then click the verification link.
#   2. IAM > create a user (e.g. "portfolio-ses") with a policy granting only
#      ses:SendEmail and ses:SendRawEmail.
#   3. Generate an access key for that user, paste below.
#
# Without these, the contact form returns a graceful error and points users
# to email JKH.Build@gmail.com directly.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=JKH.Build@gmail.com
