# Public URL of the deployed site (used for OG image, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://justinhwang.com

# Resend API key for the contact form. Get one at https://resend.com (free tier: 3000/mo).
# Without this, the contact form returns a graceful error and points users to email directly.
RESEND_API_KEY=

# Optional: override the "from" address for contact-form emails.
# Default is onboarding@resend.dev (works without domain verification).
# To use a custom domain, verify it in Resend first.
# RESEND_FROM_EMAIL=hello@yourdomain.com
